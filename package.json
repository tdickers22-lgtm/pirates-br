{
  "name": "pirates-br",
  "version": "0.1.0",
  "description": "Sea of Thieves Battle Royale",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev:bots": "npm run dev",
    "dev:server:bots": "npm run dev:server",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node scripts/run-all-tests.mjs",
    "test:logic": "node scripts/run-all-tests.mjs --logic",
    "test:browser": "node scripts/run-all-tests.mjs --browser",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:perf": "node scripts/test-perf-budget.mjs",
    "test:motion": "node scripts/test-motion-continuity.mjs",
    "test:simlag": "node scripts/test-sim-lag-honesty.mjs",
    "test:minimap": "node scripts/test-minimap.mjs",
    "play": "npm run build && node dist/server/index.js",
    "test:audit": "node scripts/run-all-tests.mjs --audit"
  },
  "dependencies": {
    "simplex-noise": "^4.0.1",
    "three": "^0.160.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "playwright": "^1.59.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
