{
  "name": "pirates-br",
  "version": "0.1.0",
  "description": "Sea of Thieves Battle Royale",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev:bots": "concurrently \"npm run dev:server:bots\" \"npm run dev:client\"",
    "dev:server:bots": "tsx watch src/server/index.ts -- --bots --bot-count=6",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "node dist/server/index.js --bots --bot-count=6"
  },
  "dependencies": {
    "three": "^0.160.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.1",
    "simplex-noise": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.6.0"
  }
}
